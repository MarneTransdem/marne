        "type": 301
      },
      {
        "source": "/demenagement-paris",
        "destination": "/secteurs-desservis",
        "type": 301
      },
      {
        "source": "/demenagement-paris-8",
        "destination": "/secteurs-desservis",
        "type": 301
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
